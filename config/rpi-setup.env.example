# rpi-setup settings - one file for every task.
#
#   1. bash setup.sh --init-config     copies this file to config/rpi-setup.env
#   2. edit config/rpi-setup.env       fill in what you want, leave the rest
#   3. sudo bash setup.sh <task ...>   splits it into config/local/<task>.env
#                                      (one file per task) and runs the tasks
#
# config/rpi-setup.env is ignored by git, so your passwords stay on the Pi.
#
# Format: one NAME=value per line, as in a shell script but nothing is
# expanded ($ and backslashes are kept as written).
#   - An empty value (NAME=) means "use the default" shown in the comment.
#   - Quote a value that contains spaces followed by #, e.g. PASS='a #1'.
#     Use single quotes if the value contains a double quote, and vice versa.
#   - Lines starting with # are comments. A line can be left out entirely.
#   - yes/no settings also accept true/false, on/off and 1/0.
#   - Every name starts with its task's name; an unknown name stops the run,
#     so a typo never goes unnoticed.
#   - A variable given on the command line wins over this file:
#       sudo SAMBA_PASSWORD=secret bash setup.sh samba
#
# Passwords left empty are generated on first install, printed once and saved
# (root-only) in /var/lib/rpi-setup/secrets/<task>.env.

# --- base: OS update, firmware, SSH, fail2ban ---------------------------------
# Run "apt-get upgrade" (skipped in containers/CI). Default: yes
BASE_UPGRADE=yes
# Update the bootloader EEPROM (applies after a reboot). Default: yes
BASE_EEPROM_UPDATE=yes
# New host name, e.g. homepi (reachable as homepi.local). Empty: keep the current one.
BASE_HOSTNAME=
# Time zone, e.g. Europe/Berlin (list: timedatectl list-timezones). Empty: keep.
BASE_TIMEZONE=
# More apt packages to install, separated by spaces or commas, e.g. "rsync jq".
BASE_EXTRA_PACKAGES=
# fail2ban: failed SSH logins before a ban, and how long the ban lasts. Default: 5, 1h
BASE_FAIL2BAN_MAXRETRY=5
BASE_FAIL2BAN_BANTIME=1h
# Raspberry Pi 5 only (ignored on other boards; both apply after a reboot):
# PCIe Gen 3 for an NVMe HAT (twice the speed; not officially certified). Default: no
BASE_PCIE_GEN3=no
# Boot the 4K-page kernel instead of the Pi 5's 16K-page one. Only needed if a
# program or container crashes with page-size or jemalloc errors. Default: no
BASE_PI5_4K_KERNEL=no

# --- docker: Docker Engine and Compose ---------------------------------------
# Add the user who runs sudo to the docker group (docker without sudo). Default: yes
DOCKER_ADD_USER=yes
# Log rotation for all containers, so logs cannot fill the SD card. Default: 10m, 3
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# --- tailscale: VPN --------------------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys for an
# unattended login. Empty: "tailscale up" prints a login URL to open.
TAILSCALE_AUTHKEY=
# Name of this Pi in your tailnet. Empty: the Pi's host name.
TAILSCALE_HOSTNAME=
# yes/no: Tailscale SSH. Empty: leave as it is.
TAILSCALE_SSH=
# yes/no: offer this Pi as an exit node (turns on IP forwarding). Empty: leave as it is.
TAILSCALE_ADVERTISE_EXIT_NODE=
# LAN subnets to reach through this Pi, comma separated, e.g. 192.168.1.0/24.
# Empty: leave as it is. (Approve routes and exit nodes in the Tailscale admin console.)
TAILSCALE_ADVERTISE_ROUTES=

# --- pihole: network-wide ad blocker --------------------------------------------
# yes: skip the "type yes" question before running Pi-hole's curl|bash installer.
PIHOLE_CONFIRM=
# yes: install without Pi-hole's dialogs, using the settings below. no: show them. Default: yes
PIHOLE_UNATTENDED=yes
# Web admin password. Empty: generated on first install (printed and saved).
# Set it later to change the password on the next run.
PIHOLE_PASSWORD=
# Network interface Pi-hole answers on, e.g. eth0 or wlan0. Empty: the default route's.
PIHOLE_INTERFACE=
# Upstream DNS servers, comma separated. Applied at install; later change them in the web UI.
PIHOLE_DNS=1.1.1.1,1.0.0.1
# yes/no: log DNS queries. Applied at install. Default: yes
PIHOLE_QUERY_LOGGING=yes
# Port of the web admin. Empty: 80, or 8080 if another web server already has 80.
PIHOLE_WEB_PORT=

# --- samba: NAS share ---------------------------------------------------------
# Linux user who owns the share and logs in to it. Empty: the user who runs sudo.
SAMBA_USER=
# SMB password of that user. Empty: generated the first time (printed and saved);
# later runs keep the existing password unless you set one here.
SAMBA_PASSWORD=
# Share name, as in \\<pi>\nas-share. Default: nas-share
SAMBA_SHARE_NAME=nas-share
# Folder to share. Empty: <home of SAMBA_USER>/<SAMBA_SHARE_NAME>
SAMBA_SHARE_PATH=
# yes/no: read-only share. Default: no
SAMBA_READ_ONLY=no

# --- web: nginx ---------------------------------------------------------------
# Port nginx listens on. Empty: 80, or 8080 if Pi-hole already has 80.
WEB_PORT=
# Title of the start page (/var/www/html/index.html; a page of your own is never overwritten).
WEB_TITLE=Raspberry Pi

# --- monitoring: Netdata dashboard ------------------------------------------------
# Dashboard port. Default: 19999
MONITORING_PORT=19999
# Address to listen on: 0.0.0.0 = whole LAN, 127.0.0.1 = this Pi only. Default: 0.0.0.0
MONITORING_BIND=0.0.0.0
# yes/no: send Netdata's anonymous usage statistics. Default: no
MONITORING_TELEMETRY=no

# --- netalertx: LAN device tracker (needs docker) ------------------------------
# Web UI port. Default: 20211
NETALERTX_PORT=20211
# Subnets to scan, e.g. '192.168.1.0/24 --interface=eth0'; several separated by ";".
# Empty: detected from the default route.
NETALERTX_SCAN_SUBNETS=
# Docker image. Default: ghcr.io/netalertx/netalertx:latest
NETALERTX_IMAGE=ghcr.io/netalertx/netalertx:latest

# --- teamspeak: TeamSpeak 6 server (needs docker, 64-bit OS) --------------------
# yes: you accept the TeamSpeak server license; the server does not start without it.
TEAMSPEAK_ACCEPT_LICENSE=yes
# Voice port (UDP). Only applies when the server is first created. Default: 9987
TEAMSPEAK_VOICE_PORT=9987
# File transfer port (TCP). Default: 30033
TEAMSPEAK_FILE_PORT=30033
# yes/no: web query API, and its port (TCP). Default: yes, 10080
TEAMSPEAK_QUERY_HTTP=yes
TEAMSPEAK_QUERY_PORT=10080
# Password of the serveradmin query account. Empty: TeamSpeak's own (none set).
TEAMSPEAK_QUERY_ADMIN_PASSWORD=
# Docker image. Default: teamspeaksystems/teamspeak6-server:latest
TEAMSPEAK_IMAGE=teamspeaksystems/teamspeak6-server:latest

# --- flash: SD card first-boot settings (host/flash.sh, host/flash.ps1) ---------
# Read on the PC that writes the card, not by setup.sh on the Pi. Remove the "#"
# in front of the lines you use. Flags and environment variables win over these.
# With none of them set the card is written exactly as before (user and SSH only).
# Host name, e.g. homepi (reachable as homepi.local). Empty: raspberrypi.
#FLASH_HOSTNAME=
# Wi-Fi network to join on first boot. Empty: no Wi-Fi (use Ethernet).
#FLASH_WIFI_SSID=
# Its password (8-63 characters). Empty: asked for while flashing.
#FLASH_WIFI_PASSWORD=
# Wi-Fi country code (regulatory domain). Default: DE
#FLASH_WIFI_COUNTRY=DE
# SSH public key to authorize for the login user, e.g. /home/you/.ssh/id_ed25519.pub
# (Windows: C:\Users\you\.ssh\id_ed25519.pub). Empty: password login only.
#FLASH_SSH_PUBKEY_FILE=
