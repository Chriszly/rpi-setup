# Settings the autodeploy task reads. Only the names live here; set the values
# in config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/autodeploy.env before running.
AUTODEPLOY_BRANCH=
AUTODEPLOY_INTERVAL=
AUTODEPLOY_TASKS=
AUTODEPLOY_REQUIRE_CI=
