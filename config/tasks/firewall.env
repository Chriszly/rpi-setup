# Settings the firewall task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/firewall.env before running.
FIREWALL_SSH_PORT=
FIREWALL_AUTO_PORTS=
FIREWALL_EXTRA_PORTS=
FIREWALL_ALLOW_FROM=
