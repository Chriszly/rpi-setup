# Settings the base task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/base.env before running.
BASE_UPGRADE=
BASE_EEPROM_UPDATE=
BASE_HOSTNAME=
BASE_TIMEZONE=
BASE_EXTRA_PACKAGES=
BASE_FAIL2BAN_MAXRETRY=
BASE_FAIL2BAN_BANTIME=
BASE_PCIE_GEN3=
BASE_PI5_4K_KERNEL=
BASE_AUTO_UPDATES=
BASE_AUTO_REBOOT=
BASE_AUTO_REBOOT_TIME=
BASE_SSH_PASSWORD_AUTH=
BASE_JOURNAL_MAX_SIZE=
