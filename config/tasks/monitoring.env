# Settings the monitoring task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/monitoring.env before running.
MONITORING_PORT=
MONITORING_BIND=
MONITORING_TELEMETRY=
MONITORING_DOCKER=
MONITORING_IMAGE=
