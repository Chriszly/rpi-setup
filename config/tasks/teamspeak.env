# Settings the teamspeak task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/teamspeak.env before running.
TEAMSPEAK_ACCEPT_LICENSE=
TEAMSPEAK_VOICE_PORT=
TEAMSPEAK_FILE_PORT=
TEAMSPEAK_QUERY_HTTP=
TEAMSPEAK_QUERY_PORT=
TEAMSPEAK_QUERY_ADMIN_PASSWORD=
TEAMSPEAK_IMAGE=
TEAMSPEAK_USAGE=
TEAMSPEAK_USAGE_DAYS=
