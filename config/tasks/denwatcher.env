# Settings the denwatcher task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/denwatcher.env before running.
DENWATCHER_PORT=
DENWATCHER_IMAGE=
DENWATCHER_ROUTERS=
DENWATCHER_ROUTER_PASSWORD=
DENWATCHER_CONTAINERS=
DENWATCHER_ADDONS=
DENWATCHER_RETENTION_DAYS=
DENWATCHER_STATUS_PORT=
