# Settings the samba task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/samba.env before running.
SAMBA_USER=
SAMBA_PASSWORD=
SAMBA_SHARE_NAME=
SAMBA_SHARE_PATH=
SAMBA_READ_ONLY=
