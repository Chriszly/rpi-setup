# Settings the tailscale task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/tailscale.env before running.
TAILSCALE_DOCKER=
TAILSCALE_IMAGE=
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=
TAILSCALE_SSH=
TAILSCALE_ADVERTISE_EXIT_NODE=
TAILSCALE_ADVERTISE_ROUTES=
TAILSCALE_ACCEPT_DNS=
