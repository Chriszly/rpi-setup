# Settings the pihole task reads. Only the names live here; set the values in
# config/rpi-setup.env (see config/rpi-setup.env.example for defaults and
# help). setup.sh splits that file into config/local/pihole.env before running.
PIHOLE_CONFIRM=
PIHOLE_UNATTENDED=
PIHOLE_PASSWORD=
PIHOLE_INTERFACE=
PIHOLE_DNS=
PIHOLE_QUERY_LOGGING=
PIHOLE_WEB_PORT=
