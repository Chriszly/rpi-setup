# Settings host/flash.sh and host/flash.ps1 read on the PC that writes the SD
# card (there is no "flash" task on the Pi). Listed so that FLASH_* lines in
# config/rpi-setup.env are known names and do not stop setup.sh.
FLASH_HOSTNAME=
FLASH_WIFI_SSID=
FLASH_WIFI_PASSWORD=
FLASH_WIFI_COUNTRY=
FLASH_SSH_PUBKEY_FILE=
FLASH_GITHUB_KEY=
