# shellcheck configuration for rpi-setup
# See https://github.com/koalaman/shellcheck/wiki/Options

# Exclude specific warnings that are intentional in this codebase
# SC1090: Can't follow non-constant source. Use a directive to specify location.
# SC1091: Not following: file not found (common.sh is sourced dynamically)
# SC2034: Variable appears unused (some variables are used in sourced files)
# SC2154: Variable is referenced but not assigned (SUDO_USER from environment)
# SC2164: Use 'cd ... || exit' or 'cd ... || return' in case cd fails
# SC2317: Command appears unreachable (intentional in error paths)
exclude=SC1090,SC1091,SC2034,SC2154,SC2164,SC2317

# Shell dialect
shell=bash

# Enable checking of sourced files
enable=all

# Output format
format=gcc